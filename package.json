{
  "name": "interceptor",
  "version": "1.0.0",
  "description": "Fast, cross-platform API client",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "electron .",
    "test": "jiti ./test/curlParser.test.ts && jiti ./test/variables.test.ts",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "start": "npm run build && electron .",
    "dev": "npm run build:electron && concurrently -k \"vite\" \"cross-env NODE_ENV=development electron .\"",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder -p never",
    "dist:mac": "npm run build && electron-builder --mac -p never",
    "dist:win": "npm run build && electron-builder --win -p never",
    "dist:linux": "npm run build && electron-builder --linux -p never",
    "dist:all": "npm run build && electron-builder -mwl -p never"
  },
  "keywords": [
    "api-client",
    "postman",
    "rest",
    "electron",
    "react"
  ],
  "author": "Adarsh Ranjan <49054080+adarsh-ranjan@users.noreply.github.com>",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
